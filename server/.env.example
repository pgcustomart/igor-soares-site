# Postgres connection string (Railway provides this)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Server
PORT=8080
NODE_ENV=development

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="is_admin_session"

# Public site origin (used for canonical/absolute URLs, sitemap, JSON-LD)
SITE_URL="https://igorsoares.adv.br"

# Initial admin seed (only used by prisma/seed.js on first run)
SEED_ADMIN_EMAIL="contato@igorsoares.adv.br"
SEED_ADMIN_NAME="Igor Soares"
