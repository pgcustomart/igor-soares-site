<!DOCTYPE html>
<html lang="pt-BR" class="no-js">
<head>
  <meta charset="UTF-8">
  <script>document.documentElement.classList.replace('no-js', 'js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/seo-meta', { title: seo.title, description: seo.description, canonical: seo.canonical, robots: seo.robots, ogType: 'website', ogImage: seo.ogImage }) %>

  <!-- Base -->
  <link rel="stylesheet" href="/css/base/reset.css">
  <link rel="stylesheet" href="/css/base/variables.css">
  <link rel="stylesheet" href="/css/base/typography.css">
  <link rel="stylesheet" href="/css/main.css">

  <!-- Components -->
  <link rel="stylesheet" href="/css/components/button.css">
  <link rel="stylesheet" href="/css/components/header.css">
  <link rel="stylesheet" href="/css/components/card.css">
  <link rel="stylesheet" href="/css/components/whatsapp-float.css">
  <link rel="stylesheet" href="/css/components/footer.css">

  <!-- Sections / Pages -->
  <link rel="stylesheet" href="/css/sections/hero.css">
  <link rel="stylesheet" href="/css/sections/artigos.css">
  <link rel="stylesheet" href="/css/pages/artigo.css">
  <link rel="stylesheet" href="/css/pages/artigos-hub.css">

  <!-- Schema.org -->
  <script type="application/ld+json"><%- JSON.stringify(breadcrumbJsonLd) %></script>
</head>
<body data-whatsapp="<%= settings.whatsapp %>">
  <a class="skip-link" href="#main">Pular para o conteúdo</a>

  <div class="site-canvas">

    <%- include('../partials/header', { currentPage: 'artigos', solid: false, headerMessage: 'Olá, Dr. Igor. Encontrei a biblioteca de artigos do site e gostaria de falar sobre um processo trabalhista.' }) %>

    <main id="main">

      <!-- ===================== HERO ===================== -->
      <section class="hero hero--content-left" id="hero" aria-label="Abertura" style="--hero-ratio: 2.339; --hero-min-height: 540px;">
        <div class="hero__media" aria-hidden="true">
          <picture>
            <source media="(max-width: 899px)" srcset="<%= hero.mobileImage %>">
            <img src="<%= hero.desktopImage %>" alt="" width="1918" height="820" loading="eager" fetchpriority="high">
          </picture>
        </div>
        <div class="hero__scrim" aria-hidden="true"></div>

        <div class="container hero__inner">
          <div class="hero__content reveal">
            <p class="eyebrow">Biblioteca Jurídica</p>
            <h1 id="artigos-hub-heading"><%- hero.title %></h1>
            <p class="lead hero__lead"><%= hero.description %></p>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="artigos-hub-heading">
        <div class="container">
          <p class="artigo-breadcrumb">
            <a href="/">Início</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Artigos</span>
          </p>

          <div class="card-grid card-grid--3 artigos-hub__grid reveal-group">
            <% articles.forEach(function(article, i) { %>
            <article class="card article-card reveal" style="--reveal-index:<%= i % 3 %>">
              <div class="article-card__image">
                <img src="<%= article.coverImage %>" alt="<%= article.coverImageAlt %>" loading="lazy">
              </div>
              <p class="article-card__meta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/></svg><%= article.readingTimeMin %> min de leitura</p>
              <h3><%= article.title %></h3>
              <p><%= article.excerpt %></p>
              <a class="article-card__link" href="/artigos/<%= article.slug %>/">Ler artigo</a>
            </article>
            <% }) %>
          </div>
          <% if (!articles.length) { %>
          <p style="text-align:center; color: var(--color-ink-faint); padding: var(--space-lg) 0;">Novos artigos em breve.</p>
          <% } %>
        </div>
      </section>
    </main>

    <%- include('../partials/footer', { settings: settings }) %>

  </div>

  <%- include('../partials/scripts', { includeFaqAccordion: false }) %>
</body>
</html>
