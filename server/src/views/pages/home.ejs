<!DOCTYPE html>
<html lang="pt-BR" class="no-js">
<head>
  <meta charset="UTF-8">
  <script>document.documentElement.classList.replace('no-js', 'js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/seo-meta', { title: seo.title, description: seo.description, canonical: siteUrl + '/', robots: 'index, follow', ogType: 'website', ogImage: seo.ogImage }) %>

  <!-- Base -->
  <link rel="stylesheet" href="/css/base/reset.css">
  <link rel="stylesheet" href="/css/base/variables.css">
  <link rel="stylesheet" href="/css/base/typography.css">
  <link rel="stylesheet" href="/css/main.css">

  <!-- Components -->
  <link rel="stylesheet" href="/css/components/button.css">
  <link rel="stylesheet" href="/css/components/header.css">
  <link rel="stylesheet" href="/css/components/card.css">
  <link rel="stylesheet" href="/css/components/faq-accordion.css">
  <link rel="stylesheet" href="/css/components/whatsapp-float.css">
  <link rel="stylesheet" href="/css/components/footer.css">

  <!-- Sections -->
  <link rel="stylesheet" href="/css/sections/hero.css">
  <link rel="stylesheet" href="/css/sections/sobre.css">
  <link rel="stylesheet" href="/css/sections/diferenciais.css">
  <link rel="stylesheet" href="/css/sections/areas-atuacao.css">
  <link rel="stylesheet" href="/css/sections/como-funciona.css">
  <link rel="stylesheet" href="/css/sections/faq.css">
  <link rel="stylesheet" href="/css/sections/artigos.css">
  <link rel="stylesheet" href="/css/sections/contato.css">
  <link rel="stylesheet" href="/css/sections/mapa.css">

  <!-- Schema.org -->
  <script type="application/ld+json"><%- JSON.stringify(attorneyJsonLd) %></script>
  <script type="application/ld+json"><%- JSON.stringify(faqJsonLd) %></script>
</head>
<body data-whatsapp="<%= settings.whatsapp %>">
  <a class="skip-link" href="#main">Pular para o conteúdo</a>

  <div class="site-canvas">

    <!-- ===================== HEADER ===================== -->
    <%- include('../partials/header', { currentPage: 'home', solid: false, headerMessage: 'Olá, Dr. Igor. Encontrei seu escritório pelo site e gostaria de falar sobre um processo trabalhista.' }) %>

    <main id="main">

      <!-- ===================== HERO ===================== -->
      <section class="hero" id="hero" aria-label="Abertura" style="--hero-ratio: 2.116; --hero-min-height: 640px;">
        <div class="hero__media" aria-hidden="true">
          <picture>
            <source media="(max-width: 899px)" srcset="<%= hero.mobileImage %>">
            <img src="<%= hero.desktopImage %>" alt="" width="1824" height="862" loading="eager" fetchpriority="high">
          </picture>
        </div>
        <div class="hero__scrim" aria-hidden="true"></div>

        <div class="container hero__inner">
          <div class="hero__content reveal">
            <p class="eyebrow">Direito do Trabalho</p>
            <h1><%- hero.title %></h1>
            <p class="lead hero__lead"><%= hero.subtitle %></p>
            <div class="hero__actions">
              <a class="btn btn--primary btn--lg js-whatsapp" href="#" data-wa-message="<%= hero.whatsappMessage %>">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-9.99 4.47-9.99 9.99 0 1.76.46 3.48 1.34 5L2 22l5.15-1.35a9.96 9.96 0 0 0 4.89 1.28h.005c5.52 0 9.99-4.47 9.99-9.99C22.03 6.47 17.56 2 12.04 2Zm0 18.18h-.004a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.05.8.82-2.97-.2-.3a8.2 8.2 0 0 1-1.26-4.38c0-4.53 3.69-8.22 8.23-8.22 2.2 0 4.26.86 5.82 2.41a8.17 8.17 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Z"/></svg>
                <%= hero.whatsappLabel %>
              </a>
              <a class="btn btn--outline-gold btn--lg js-whatsapp" href="#" data-wa-message="<%= hero.scheduleMessage %>">
                <%= hero.scheduleLabel %>
              </a>
            </div>
            <a class="hero__scroll-hint" href="#como-funciona">
              Como funciona
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </a>
          </div>
        </div>
      </section>

      <!-- ===================== SOBRE ===================== -->
      <section class="section" id="sobre" aria-labelledby="sobre-heading">
        <div class="container sobre__grid">
          <div class="sobre__media reveal">
            <div class="media-frame media-frame--portrait">
              <img src="/assets/images/sobre/igor-soares.jpg" alt="Igor Soares, advogado, em atendimento no escritório" width="640" height="640" loading="lazy">
            </div>
          </div>

          <div class="sobre__content reveal">
            <p class="eyebrow">Sobre</p>
            <h2 id="sobre-heading">Igor Soares</h2>
            <p class="lead" style="margin-top: var(--space-md);">Advogado com <strong>mais de 10 anos de atuação exclusiva em Direito do Trabalho</strong>, dedicado à defesa dos direitos de empregados e trabalhadores em geral.</p>
            <p style="margin-top: var(--space-md);">O trabalho começa pela escuta atenta de cada cliente. Cada processo tem as suas particularidades, e é a partir delas que a estratégia é construída.</p>
            <p>Depois de mais de dez anos na área, cada demanda é conduzida com o mesmo cuidado: planejamento bem feito e acompanhamento próximo, sempre pensando no que faz mais sentido para aquele caso.</p>
            <p>Atender um número reduzido de processos por vez é o que permite essa atuação mais próxima, com presença direta do primeiro atendimento até a conclusão do caso.</p>
            <div class="sobre__actions">
              <a class="btn btn--outline js-whatsapp" href="#" data-wa-message="Olá, Igor. Gostaria de saber mais sobre o seu atendimento.">Falar no WhatsApp</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== DIFERENCIAIS ===================== -->
      <section class="section section--alt diferenciais" id="diferenciais" aria-labelledby="diferenciais-heading">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Diferenciais</p>
            <h2 id="diferenciais-heading">Como a atuação é conduzida</h2>
          </div>

          <div class="card-grid card-grid--4 reveal-group">
            <div class="card reveal" style="--reveal-index:0">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5h16v10H9.5L5 19v-3.5H4z"/></svg>
              </div>
              <h3>Condução Direta do Caso</h3>
              <p>O próprio advogado acompanha cada processo do início ao fim, sem intermediários.</p>
            </div>

            <div class="card reveal" style="--reveal-index:1">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
              </div>
              <h3>Comunicação Direta</h3>
              <p>As informações são explicadas com clareza, sem o excesso de termos técnicos que só afasta o cliente do que realmente importa.</p>
            </div>

            <div class="card reveal" style="--reveal-index:2">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/></svg>
              </div>
              <h3>Prazos e Organização</h3>
              <p>Cumprir prazos e manter cada processo em ordem também é uma forma de respeito com quem confia o caso a este trabalho.</p>
            </div>

            <div class="card reveal" style="--reveal-index:3">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M14.6 9.4 13 13l-3.6 1.6L11 11z"/></svg>
              </div>
              <h3>Negociação Estratégica</h3>
              <p>Cada decisão passa por uma avaliação cuidadosa, sempre em busca do caminho mais adequado para aquele caso.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== ÁREAS DE ATUAÇÃO ===================== -->
      <section class="section areas" id="atuacao" aria-labelledby="atuacao-heading">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Áreas de Atuação</p>
            <h2 id="atuacao-heading">Direito do Trabalho, em detalhe</h2>
          </div>

          <div class="card-grid card-grid--3 reveal-group">
            <div class="card reveal" style="--reveal-index:0">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3.5h7l4 4v13H7z"/><path d="M14 3.5v4h4M9.5 12h6M9.5 15.5h6"/></svg>
              </div>
              <h3>Rescisão e Verbas Trabalhistas</h3>
              <p>Conferência dos valores devidos na rescisão e cobrança de verbas pagas de forma incorreta ou que ainda não foram quitadas.</p>
            </div>

            <div class="card reveal" style="--reveal-index:1">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="14" height="15" rx="1.5"/><circle cx="12" cy="11" r="2"/><path d="M8.5 17c0-1.8 1.6-3 3.5-3s3.5 1.2 3.5 3"/></svg>
              </div>
              <h3>Reconhecimento de Vínculo</h3>
              <p>Para quem trabalha como prestador de serviços ou sem carteira assinada, mas reúne na prática os requisitos de uma relação de emprego.</p>
            </div>

            <div class="card reveal" style="--reveal-index:2">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/></svg>
              </div>
              <h3>Horas Extras Não Pagas</h3>
              <p>Apuração da jornada realmente cumprida e cobrança de horas extras não pagas ou compensadas de forma incorreta.</p>
            </div>

            <div class="card reveal" style="--reveal-index:3">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5 18.5 6v6c0 4-2.7 6.8-6.5 8.5C8.2 18.8 5.5 16 5.5 12V6z"/></svg>
              </div>
              <h3>Assédio Moral no Trabalho</h3>
              <p>Orientação e atuação judicial diante de situações de constrangimento, humilhação ou pressão abusiva no ambiente de trabalho.</p>
            </div>

            <div class="card reveal" style="--reveal-index:4">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M8.5 12h2l1.2-2.6 1.6 5 1.2-2.4h2"/></svg>
              </div>
              <h3>Acidente de Trabalho</h3>
              <p>Análise de acidentes e doenças ocupacionais para verificar direitos, estabilidade provisória e eventual indenização.</p>
            </div>

            <div class="card reveal" style="--reveal-index:5">
              <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M8.5 12.5l2.3 2.3L15.7 9.4"/></svg>
              </div>
              <h3>Justa Causa Indevida</h3>
              <p>Análise de demissões por justa causa aplicadas sem motivo suficiente ou de forma desproporcional à falta cometida.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== COMO FUNCIONA ===================== -->
      <section class="section section--alt" id="como-funciona" aria-labelledby="como-funciona-heading">
        <div class="container">
          <div class="section-heading section-heading--center reveal">
            <p class="eyebrow">Como Funciona</p>
            <h2 id="como-funciona-heading">Do primeiro contato à solução</h2>
          </div>

          <ol class="timeline reveal-group">
            <li class="timeline__step reveal" style="--reveal-index:0">
              <span class="timeline__index">01</span>
              <h3>Contato inicial</h3>
              <p>Tudo começa com o relato do caso pelo WhatsApp e uma primeira avaliação da situação.</p>
            </li>
            <li class="timeline__step reveal" style="--reveal-index:1">
              <span class="timeline__index">02</span>
              <h3>Análise do caso</h3>
              <p>Documentos e informações são reunidos para entender o caso em detalhe.</p>
            </li>
            <li class="timeline__step reveal" style="--reveal-index:2">
              <span class="timeline__index">03</span>
              <h3>Reunião</h3>
              <p>Quando necessário, a conversa continua por videochamada ou presencialmente no escritório.</p>
            </li>
            <li class="timeline__step reveal" style="--reveal-index:3">
              <span class="timeline__index">04</span>
              <h3>Estratégia e acompanhamento</h3>
              <p>A estratégia é definida em conjunto, e o acompanhamento continua de perto em cada etapa do processo.</p>
            </li>
          </ol>
        </div>
      </section>

      <!-- ===================== FAQ ===================== -->
      <section class="section faq" id="faq" aria-labelledby="faq-heading">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Dúvidas Frequentes</p>
            <h2 id="faq-heading">Perguntas Frequentes</h2>
          </div>

          <div class="faq__layout reveal">
            <div class="faq-list" id="faq-list">
              <div class="faq-item" data-open="false">
                <h3>
                  <button class="faq-item__trigger" aria-expanded="false">
                    Quanto tempo tenho para entrar com uma ação trabalhista?
                    <span class="faq-item__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="faq-item__panel">
                  <div class="faq-item__panel-inner">
                    <p>Em regra, o prazo é de dois anos a partir do fim do contrato, para reivindicar direitos dos últimos cinco anos da relação de trabalho. Cada caso pode ter particularidades que mudam essa contagem, por isso vale procurar orientação o quanto antes.</p>
                  </div>
                </div>
              </div>

              <div class="faq-item" data-open="false">
                <h3>
                  <button class="faq-item__trigger" aria-expanded="false">
                    Preciso ir até o escritório para o primeiro atendimento?
                    <span class="faq-item__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="faq-item__panel">
                  <div class="faq-item__panel-inner">
                    <p>Não. O primeiro contato é feito pelo WhatsApp. Se o caso exigir mais detalhes, uma reunião por vídeo ou presencial é marcada conforme a preferência do cliente.</p>
                  </div>
                </div>
              </div>

              <div class="faq-item" data-open="false">
                <h3>
                  <button class="faq-item__trigger" aria-expanded="false">
                    Como funcionam os honorários?
                    <span class="faq-item__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="faq-item__panel">
                  <div class="faq-item__panel-inner">
                    <p>Os valores e a forma de pagamento são definidos depois da análise do caso, e sempre apresentados com clareza antes de qualquer decisão.</p>
                  </div>
                </div>
              </div>

              <div class="faq-item" data-open="false">
                <h3>
                  <button class="faq-item__trigger" aria-expanded="false">
                    Meu caso tem chance de sucesso?
                    <span class="faq-item__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="faq-item__panel">
                  <div class="faq-item__panel-inner">
                    <p>Cada processo tem as suas particularidades, e uma avaliação honesta vale mais do que qualquer promessa antecipada. Por isso, a conversa inicial é o melhor caminho para entender as chances reais do caso.</p>
                  </div>
                </div>
              </div>

              <div class="faq-item" data-open="false">
                <h3>
                  <button class="faq-item__trigger" aria-expanded="false">
                    O atendimento é só para quem mora no Rio de Janeiro?
                    <span class="faq-item__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="faq-item__panel">
                  <div class="faq-item__panel-inner">
                    <p>O primeiro contato pode partir de qualquer lugar, pelo WhatsApp. Já a necessidade de um encontro presencial é avaliada conforme as circunstâncias de cada caso.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== ARTIGOS ===================== -->
      <section class="section section--alt" id="artigos" aria-labelledby="artigos-heading">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Artigos</p>
            <h2 id="artigos-heading">Para entender melhor o Direito do Trabalho</h2>
          </div>

          <div class="card-grid card-grid--3 reveal-group">
            <% latestArticles.forEach(function(article, i) { %>
            <article class="card article-card reveal" style="--reveal-index:<%= i %>">
              <div class="article-card__image">
                <img src="<%= article.coverImage %>" alt="<%= article.coverImageAlt %>" loading="lazy">
              </div>
              <p class="article-card__meta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/></svg><%= article.readingTimeMin %> min de leitura</p>
              <h3><%= article.title %></h3>
              <p><%= article.excerpt %></p>
              <a class="article-card__link" href="/artigos/<%= article.slug %>/">Ler artigo</a>
            </article>
            <% }) %>
          </div>

          <p class="artigos__ver-todos reveal">
            <a class="link-arrow" href="/artigos/">
              Ver todos os artigos
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </p>
        </div>
      </section>

      <!-- ===================== CONTATO ===================== -->
      <section class="section" id="contato" aria-labelledby="contato-heading">
        <div class="container contato__box">
          <p class="eyebrow" style="justify-content:center;">Contato</p>
          <h2 id="contato-heading">Vamos conversar sobre o seu caso</h2>
          <p class="lead" style="margin-inline:auto; margin-top: var(--space-md);">O primeiro passo é contar o que aconteceu, para uma primeira avaliação do caso.</p>

          <div class="contato__actions">
            <a class="btn btn--primary btn--lg js-whatsapp" href="#" data-wa-message="Olá, Igor. Gostaria de falar sobre o meu caso.">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-9.99 4.47-9.99 9.99 0 1.76.46 3.48 1.34 5L2 22l5.15-1.35a9.96 9.96 0 0 0 4.89 1.28h.005c5.52 0 9.99-4.47 9.99-9.99C22.03 6.47 17.56 2 12.04 2Zm0 18.18h-.004a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.05.8.82-2.97-.2-.3a8.2 8.2 0 0 1-1.26-4.38c0-4.53 3.69-8.22 8.23-8.22 2.2 0 4.26.86 5.82 2.41a8.17 8.17 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Z"/></svg>
              Falar no WhatsApp
            </a>

            <div class="contato__alt">
              <a href="tel:+<%= settings.whatsapp %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 6.2 2 2 0 0 1 6 4Z"/></svg>
                <%= settings.phone %>
              </a>
              <a href="mailto:<%= settings.email %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="M4 6.5l8 6 8-6"/></svg>
                <%= settings.email %>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== MAPA ===================== -->
      <section class="section section--alt" id="mapa" aria-labelledby="mapa-heading">
        <div class="container">
          <div class="section-heading reveal">
            <p class="eyebrow">Localização</p>
            <h2 id="mapa-heading">Onde estou</h2>
          </div>

          <div class="mapa__layout reveal">
            <div class="mapa__frame">
              <iframe
                title="Mapa de localização: <%= settings.address %>"
                src="<%= settings.googleMapsUrl %>"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>

            <div class="mapa__card">
              <h3>Atendimento presencial</h3>
              <p class="mapa__card-note">Atendimento mediante agendamento.</p>

              <div class="mapa__card-row">
                <svg class="mapa__card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.7-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.3-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>
                <address style="font-style: normal;"><%= settings.address %><% if (settings.addressComplement) { %><br><%= settings.addressComplement %><% } %></address>
              </div>

              <div class="mapa__card-row">
                <svg class="mapa__card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/></svg>
                <p><%= settings.hours %></p>
              </div>

              <div class="mapa__card-actions">
                <a class="btn btn--outline" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(settings.address) %>" target="_blank" rel="noopener">
