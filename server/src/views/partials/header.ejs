<header class="site-header<%= solid ? ' site-header--solid' : '' %>" id="site-header">
      <div class="container site-header__inner">
        <a href="<%= currentPage === 'home' ? '#hero' : '/' %>" class="site-header__logo">
          <img src="/assets/images/logo/logo-mark.svg" alt="" width="220" height="290" class="site-header__mark">
          <span class="site-header__wordmark">
            Igor Soares
            <span>Advogado | Direito do Trabalho</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Navegação principal">
          <a href="/#atuacao">Áreas de Atuação</a>
          <a href="/#diferenciais">Diferenciais</a>
          <a href="/artigos/"<%= (currentPage === 'artigos' || currentPage === 'artigo') ? ' aria-current="page"' : '' %>>Artigos</a>
        </nav>

        <a class="btn btn--primary site-header__cta js-whatsapp" href="#" data-wa-message="<%= headerMessage %>">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-9.99 4.47-9.99 9.99 0 1.76.46 3.48 1.34 5L2 22l5.15-1.35a9.96 9.96 0 0 0 4.89 1.28h.005c5.52 0 9.99-4.47 9.99-9.99C22.03 6.47 17.56 2 12.04 2Zm0 18.18h-.004a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.05.8.82-2.97-.2-.3a8.2 8.2 0 0 1-1.26-4.38c0-4.53 3.69-8.22 8.23-8.22 2.2 0 4.26.86 5.82 2.41a8.17 8.17 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Z"/></svg>
          Falar no WhatsApp
        </a>

        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <nav class="mobile-nav" id="mobile-nav" aria-label="Navegação mobile">
      <ul>
        <li><a href="/#atuacao">Áreas de Atuação</a></li>
        <li><a href="/#diferenciais">Diferenciais</a></li>
        <li><a href="/artigos/">Artigos</a></li>
      </ul>
      <a class="btn btn--primary js-whatsapp" href="#" data-wa-message="<%= headerMessage %>">Falar no WhatsApp</a>
    </nav>
